APP_ENV=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/grocerydb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=yourpassword
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_FORMAT_SQL=true

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_EXPIRATION_MS=86400000

PASSWORD_RESET_EXPIRATION_MINUTES=45
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
# Supported values: console, resend, disabled
# Use console for local/dev. Use disabled in production until real email delivery is configured.
PASSWORD_RESET_DELIVERY_MODE=console

# Required only when PASSWORD_RESET_DELIVERY_MODE=resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=Grocery App
